{
  "Comment": "Process reviews using Step Functions Map state.",
  "StartAt": "Get Reviews",
  "States": {
    "Get Reviews": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "GetReviews Lambda Function ARN"
      },
      "Next": "Process Reviews Map",
      "OutputPath": "$.Payload.body"
    },
    "Process Reviews Map": {
      "Type": "Map",
      "MaxConcurrency": 10,
      "Iterator": {
        "StartAt": "Process Review",
        "States": {
          "Process Review": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "ProcessReviews Lambda Function ARN",
              "Payload.$": "$"
            },
            "End": true
          }
        }
      },
      "End": true
    }
  }
}